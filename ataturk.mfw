   "items": [
    {
     "title": "Doğum ve doğduğu ev",
     "tag": "1881",
     "text": "Mustafa 1881'de Selanik'te, Koca Kasım Paşa Mahallesi'ndeki üç katlı bir evde doğdu. Selanik o dönemde Osmanlı'nın en canlı liman kentlerinden biriydi; Türkler, Rumlar, Yahudiler, Bulgarlar ve Avrupalı tüccarlar aynı sokaklarda yaşıyordu.||Kesin doğum günü kayıtlı olmadığı için Atatürk sonraları 19 Mayıs'ı kendi doğum günü olarak benimsedi. Doğduğu ev bugün müze olarak ziyaret edilebilir.",
     "keywords": "selanik doğum ev müze 19 mayıs doğum günü"
    },
    {
     "title": "Babası: Ali Rıza Efendi",
     "tag": "",
     "text": "Ali Rıza Efendi Selanik'te memurluk yapmış, sonra kereste ticaretine girişmişti. Yeniliğe açık, eğitime önem veren biriydi ve oğlunun modern bir okulda okumasını istedi.||1888'de vefat ettiğinde Mustafa henüz yedi yaşındaydı; bu kayıp ailenin hayatını baştan aşağı değiştirdi.",
     "keywords": "baba ali rıza efendi memur kereste"
    },
    {
     "title": "Annesi: Zübeyde Hanım",
     "tag": "",
     "text": "Zübeyde Hanım dindar, kararlı ve oğluna çok bağlı bir kadındı. Oğlunun din eğitimi almasını isterdi ama onun askerlik tercihine zamanla saygı duydu.||14 Ocak 1923'te İzmir'de vefat etti; Atatürk bu kaybı çok derin hissetti.",
     "keywords": "zübeyde hanım anne vefat 1923 izmir"
    },
    {
     "title": "Kardeşleri",
     "tag": "",
     "text": "Mustafa'nın birkaç kardeşi daha vardı; Fatma, Ahmet, Ömer ve Naciye küçük yaşta hayatını kaybetti. Yalnızca kız kardeşi Makbule (Atadan) yetişkinliğe ulaştı (1885–1956). Makbule Hanım ağabeyine ömür boyu yakın kaldı.",
     "keywords": "kardeş makbule atadan"
    },
    {
     "title": "İlk okul: iki farklı fikir",
     "tag": "",
     "text": "Ailede ilk büyük tartışma Mustafa'nın okuluydu. Annesi mahalle mektebini, babası yeni usulle eğitim veren Şemsi Efendi Okulu'nu istiyordu.||Sonunda Mustafa önce mahalle mektebine törenle başlatıldı, kısa süre sonra Şemsi Efendi Okulu'na geçti. Bu okulda öğretim ezbere değil anlamaya dayanıyordu.",
     "keywords": "şemsi efendi mahalle mektebi okul tören ilk okul"
    },
    {
     "title": "Langaza çiftliğinde",
     "tag": "Babasının ölümünden sonra",
     "text": "Babasını kaybedince annesiyle birlikte Langaza yakınlarındaki dayısı Hüseyin Efendi'nin çiftliğine gitti. Orada tarla işlerini ve hayvan bakımını öğrendi; doğaya ve tarıma sevgisi bu yıllarda kök saldı.||Bu izler, yıllar sonra Ankara'da Atatürk Orman Çiftliği'ni kurmasında da görülür.",
     "keywords": "langaza çiftlik dayı hüseyin tarım doğa"
    },
    {
     "title": "Selanik'e dönüş",
     "tag": "",
     "text": "Okul çağında yeniden Selanik'e döndü ve sivil bir okula (Mülkiye Rüştiyesi) yazıldı. Ama içinde asker olma isteği büyüyordu; üniformalı subaylara ve ordunun disiplinine hayrandı.",
     "keywords": "selanik mülkiye rüştiyesi asker hayal"
    },
    {
     "title": "Gizli askerî sınav",
     "tag": "1893",
     "text": "Annesine danışmadan Selanik Askerî Rüştiyesi'nin sınavına girdi ve kazandı. Zübeyde Hanım ilk anda çok üzüldü; oğlunun kararlılığını görünce razı oldu.||Bu, Mustafa'nın hayatını belirleyen ilk bilinçli kararlarından biridir.",
     "keywords": "gizli sınav askeri rüştiye 1893 asker olmak"
    },
    {
     "title": "“Kemal” adı",
     "tag": "1893",
     "text": "Askerî Rüştiye'de matematik öğretmeni Yüzbaşı Mustafa Efendi, aynı adı taşıyan öğrencisini ayırt etmek ve başarısını ödüllendirmek için ona “Kemal” (olgunluk) adını verdi. Böylece “Mustafa”, “Mustafa Kemal” oldu.",
     "keywords": "kemal adı matematik öğretmeni mustafa efendi isim"
    },
    {
     "title": "Çocukluk karakteri",
     "tag": "",
     "text": "Çevresindekilerin anlatımlarına göre küçük Mustafa meraklı, atılgan, arkadaş canlısı ve liderlik özelliği gösteren bir çocuktu; oyunlarda ve sınıfta ön plana çıkardı. Öğrenme ve okuma isteği çok erken yaşta belirgindi.",
     "keywords": "karakter çocukluk merak liderlik"
    }
   ]
