  {
   "id": "sozler",
   "title": "Sözleri",
   "lead": "Kısa ve akılda kalan bazı sözleri. (Tarih ve bağlamlar kaynaklara göre değişebilir.)",
   "type": "q",
   "items": [
    {
     "text": "Egemenlik kayıtsız şartsız milletindir.",
     "note": "Millî egemenlik ilkesi"
    },
    {
     "text": "Hayatta en hakiki mürşit ilimdir, fendir.",
     "note": "Öğretmenlere hitaben (1924)"
    },
    {
     "text": "Yurtta sulh, cihanda sulh.",
     "note": "Barış ilkesi"
    },
    {
     "text": "Ne mutlu Türküm diyene!",
     "note": "Cumhuriyet'in 10. yıl nutku (1933)"
    },
    {
     "text": "Türk, öğün, çalış, güven.",
     "note": "10. yıl nutku (1933)"
    },
    {
     "text": "Hattı müdafaa yoktur, sathı müdafaa vardır. O satıh bütün vatandır.",
     "note": "Sakarya Meydan Muharebesi (1921)"
    },
    {
     "text": "Ordular! İlk hedefiniz Akdeniz'dir. İleri!",
     "note": "1 Eylül 1922"
    },
    {
     "text": "Size taarruz etmeyi değil, ölmeyi emrediyorum.",
     "note": "Çanakkale (1915), anlatıldığına göre"
    },
    {
     "text": "Muallimler! Yeni nesil sizin eseriniz olacaktır.",
     "note": "Öğretmenlere hitabı"
    },
    {
     "text": "Benim naçiz vücudum elbet bir gün toprak olacaktır, ancak Türkiye Cumhuriyeti ilelebet payidar kalacaktır.",
     "note": "Sık alıntılanan söz"
    },
    {
     "text": "Sanatsız kalan bir milletin hayat damarlarından biri kopmuş demektir.",
     "note": "Sanata verdiği önem"
    },
    {
     "text": "Medeniyet öyle kuvvetli bir ateştir ki, ona kayıtsız kalanları yakar, yok eder.",
     "note": "Medeniyet üzerine"
    },
    {
     "text": "Bütün ümidim gençliktedir.",
     "note": "Gençliğe güveni"
    },
    {
     "text": "Birinci vazifen, Türk istiklalini, Türk Cumhuriyeti'ni ilelebet muhafaza ve müdafaa etmektir.",
     "note": "Gençliğe Hitabe (1927)"
    }
   ]
