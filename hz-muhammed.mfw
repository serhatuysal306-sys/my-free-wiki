    {
     "year": "613",
     "title": "Açık davet",
     "text": "Safâ Tepesi'nde Mekkelileri İslam'a açıkça davet etti. Kureyş'in baskıları arttı.",
     "events": [
      "Safâ Tepesi daveti"
     ],
